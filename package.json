{
  "name": "title-bar",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Theme-aware custom title bar with integrated menu.",
  "keywords": [
    "frameless",
    "menu",
    "window-controls",
    "custom",
    "menubar"
  ],
  "repository": "https://github.com/lumine-code/title-bar",
  "bugs": {
    "url": "https://github.com/lumine-code/title-bar/issues"
  },
  "license": "MIT",
  "main": "./lib/main.js",
  "files": [
    "docs",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "controlTheme": {
      "title": "Window Controls Theme",
      "description": "Visual style used for the window control buttons.",
      "type": "string",
      "enum": [
        "Default",
        "Windows 11",
        "macOS Tahoe",
        "GNOME"
      ],
      "default": "Default"
    },
    "customContextMenus": {
      "title": "Custom Context Menus",
      "description": "Use custom styled HTML context menus instead of native Electron menus. Matches the title bar styling.",
      "type": "boolean",
      "default": true
    },
    "autoHide": {
      "title": "Auto Hide Menu Bar",
      "description": "Automatically hide the menu bar and toggle it by pressing Alt.",
      "type": "boolean",
      "default": true
    },
    "altGivesFocus": {
      "title": "Alt Gives Focus",
      "description": "Releasing the alt key gives focus to the application menu.",
      "type": "boolean",
      "default": true
    }
  },
  "providedServices": {
    "title-bar": {
      "versions": {
        "1.0.0": "provideTitleBar"
      }
    }
  },
  "dependencies": {
    "@lumine-code/underscore-plus": "https://github.com/lumine-code/underscore-plus.git#2b75d264c2ca01d27ee69d7cd05610a097011274"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
